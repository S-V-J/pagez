# ==============================================================================
# Pagez root .gitignore
# SYSTEMIC ROLE:
#   Prevents dependencies, build outputs, local runtime state, secrets, logs,
#   caches, test artifacts, IDE files, OS files, and infrastructure credentials
#   from being committed into the Pagez monorepo.
# ==============================================================================

# Dependencies
node_modules/
.pnpm-store/
.pnpm/

# Build outputs
.next/
out/
dist/
build/
frontend/.next/
frontend/out/
backend/dist/

# Next.js generated TypeScript declaration file.
# This file is regenerated by next dev, next build, and next typegen.
# It is local tooling state, not application source, and must not be committed.
frontend/next-env.d.ts

# Pagez local runtime state.
# This directory stores dynamic port assignments, PID files, sockets, and logs
# produced by the custom pagez lifecycle command.
.pagez/

# Environment files
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Local runtime state
run/
*.pid
*.seed
*.pid.lock

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Operating system files
.DS_Store
Thumbs.db

# Docker and local compose overrides
docker-compose.override.yml

# Testing and coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Caches and temporary files
.cache/
.tmp/
tmp/
*.tsbuildinfo
.eslintcache
.stylelintcache

# Monorepo and build tooling caches
.turbo/
.vercel/

# Cloudflare Tunnel and local infrastructure secrets
.cloudflared/
*.pem
*.key
secrets/
vault/

# Miscellaneous
*.tgz
*.tar.gz

# Nested pnpm workspace configs are forbidden in the Pagez monorepo.
frontend/pnpm-workspace.yaml
backend/pnpm-workspace.yaml

# Nested backend gitignore files are forbidden; root .gitignore is authoritative.
backend/.gitignore

# Python virtual environments and Python build/cache artifacts.
# These are allowed to exist locally for maintainer convenience,
# but they are not part of the Pagez TypeScript application source.
venv/
.venv/
env/
.env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
